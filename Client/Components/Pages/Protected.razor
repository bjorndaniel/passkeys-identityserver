@page "/protected"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Protected Page</PageTitle>

<h1>Protected Page</h1>

<p>This page requires authentication. If you can see this, you're successfully authenticated!</p>

<AuthorizeView>
    <Authorized>
        <div class="alert alert-success">
            <h4>Welcome, @context.User.Identity!.Name!</h4>
            <p>You are successfully authenticated with the Identity Server.</p>
            
            <h5>Your Claims:</h5>
            <ul>
                @foreach (var claim in context.User.Claims)
                {
                    <li><strong>@claim.Type:</strong> @claim.Value</li>
                }
            </ul>
        </div>
    </Authorized>
</AuthorizeView>

@code {

}